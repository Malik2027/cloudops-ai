[Unit]
Description={{ app_name }} FastAPI application
After=network.target
Wants=network-online.target

[Service]
Type=exec
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}/current
EnvironmentFile={{ app_dir }}/shared/config/.env
ExecStart={{ app_dir }}/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port {{ app_port }} \
    --workers {{ uvicorn_workers }} \
    --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ app_name }}

Environment=PYTHONPATH={{ app_dir }}/current
Environment=ENV={{ app_env }}
Environment=PORT={{ app_port }}

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ app_dir }}/shared/logs

[Install]
WantedBy=multi-user.target
