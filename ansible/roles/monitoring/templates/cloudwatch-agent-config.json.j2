{
  "agent": {
    "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
    "run_as_user": "cwagent"
  },
  "metrics": {
    "namespace": "CloudOpsAI/{{ app_env }}",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "Environment": "{{ app_env }}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
        "totalcpu": true
      },
      "disk": {
        "measurement": [
          "used_percent",
          "inodes_free"
        ],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }}
      },
      "netstat": {
        "measurement": [
          "tcp_established",
          "tcp_time_wait"
        ],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }}
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/{{ app_name }}_access.log",
            "log_group_name": "{{ cloudwatch_log_group_prefix }}/{{ app_env }}/nginx/access",
            "log_stream_name": "{instance_id}",
            "timestamp_format": "%d/%b/%Y:%H:%M:%S %z"
          },
          {
            "file_path": "/var/log/nginx/{{ app_name }}_error.log",
            "log_group_name": "{{ cloudwatch_log_group_prefix }}/{{ app_env }}/nginx/error",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "{{ cloudwatch_log_group_prefix }}/{{ app_env }}/syslog",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/opt/cloudops/shared/logs/*.log",
            "log_group_name": "{{ cloudwatch_log_group_prefix }}/{{ app_env }}/app",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
